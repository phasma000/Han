local function FriendsFile() return "hanami_friends.json" end
local function CfgFile(slot) return "hanami_cfg_"..(slot or "default")..".json" end

local function Serializable(t)
    local out = {}
    for k, v in pairs(t) do
        local tv = type(v)
        if tv == "number" or tv == "string" or tv == "boolean" then
            out[k] = v
        elseif tv == "userdata" then
            pcall(function()
                if typeof(v) == "Color3" then
                    out[k] = {__c3 = true, r=v.R, g=v.G, b=v.B}
                elseif typeof(v) == "EnumItem" then
                    out[k] = {__enum = true, enumType=v.EnumType.Name, name=v.Name}
                end
            end)
        elseif tv == "table" then
            out[k] = Serializable(v)
        end
    end
    return out
end

local function Deserialize(t)
    local out = {}
    for k, v in pairs(t) do
        if type(v) == "table" then
            if v.__c3 then out[k] = Color3.new(v.r, v.g, v.b)
            elseif v.__enum then
                pcall(function()
                    local et = Enum[v.enumType]
                    if et then out[k] = et[v.name] end
                end)
            else out[k] = Deserialize(v) end
        else out[k] = v end
    end
    return out
end

local function SaveFriends()
    pcall(function()
        if writefile then writefile(FriendsFile(), HS:JSONEncode(S.friends)) end
    end)
end
local function LoadFriends()
    pcall(function()
        if isfile and isfile(FriendsFile()) then
            S.friends = HS:JSONDecode(readfile(FriendsFile())) or {}
        end
    end)
end
local function SaveConfig(slot)
    slot = slot or S.cfgSlot
    pcall(function()
        if writefile then writefile(CfgFile(slot), HS:JSONEncode(Serializable(S))) end
    end)
end
local function LoadConfig(slot)
    slot = slot or S.cfgSlot
    pcall(function()
        if isfile and isfile(CfgFile(slot)) then
            local d = HS:JSONDecode(readfile(CfgFile(slot)))
            local r = Deserialize(d)
            for k, v in pairs(r) do if S[k] ~= nil then S[k] = v end end
        end
    end)
end

