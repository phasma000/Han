    end
end))
Track(UIS.InputChanged:Connect(function(inp)
    if not dragging then return end
    if inp.UserInputType == Enum.UserInputType.MouseMovement
    or inp.UserInputType == Enum.UserInputType.Touch then
        local d = inp.Position - dragSt
        Main.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + d.X,
            dragPos.Y.Scale, dragPos.Y.Offset + d.Y)
    end
end))

-- ============================================================
-- RENDER LOOP
-- ============================================================
local sessionStart = os.clock()
local accText = 0
local accESP = 0
local fpsAcc, fpsFrames, fpsVal, fpsTimer = 0, 0, 0, 0

Track(RS.RenderStepped:Connect(function(dt)
    RecordFrame(dt)

    fpsAcc += dt; fpsFrames += 1; fpsTimer += dt
    if fpsTimer >= 0.5 then
        fpsVal = math.floor(fpsFrames / fpsAcc)
        fpsAcc = 0; fpsFrames = 0; fpsTimer = 0
    end

    FOVCont.Visible = S.showFov and S.aim and Held()
    if FOVCont.Visible then
        local r = S.fov * 2
        FOVCont.Size = UDim2.fromOffset(r, r)
        local vp = Camera.ViewportSize
        FOVCont.Position = UDim2.fromOffset(vp.X/2 - r/2, vp.Y/2 - r/2)
        FOVCont.AnchorPoint = Vector2.new(0, 0)
        FOVCircle.Visible = S.fovShape == "Circle"
        FOVSquare.Visible = S.fovShape ~= "Circle"
        FOVCircleStroke.Color = S.aimColor
        FOVSquareStroke.Color = S.aimColor
    end

    Cross.Visible = S.crossDot and S.open
    if Cross.Visible then Cross.BackgroundColor3 = S.crossColor end

    if S.aim and (Held() or not S.holdOnly) then
        if ReactionReady() then
            local tgt = Target()
            if tgt then
                local aimPos = tgt.Position
                if S.predOn then
                    pcall(function()
                        local vel = tgt.AssemblyLinearVelocity
                        if vel then aimPos = aimPos + vel * S.predLead end
                    end)
                end
                if S.humanJitter then
                    local amp = S.humanJitterAmp
                    aimPos = aimPos + Vector3.new(
                        (math.random()-0.5) * amp,
                        (math.random()-0.5) * amp,
                        (math.random()-0.5) * amp
                    )
                end
                local desired = CFrame.lookAt(Camera.CFrame.Position, aimPos)
                local rawA = math.clamp(S.smooth * 6 * dt, 0.01, 0.5)
                local a = CurveAlpha(rawA, S.smoothCurve)
                Camera.CFrame = Camera.CFrame:Lerp(desired, a)
            end
        end
    else
        ReactionReset()
    end

    TickTrigger()

    if S.esp then
        accESP += dt
        local hz = EffectiveEspHz()
        if accESP >= (1 / math.max(1, hz)) then
            accESP = 0
            TickESP()
        end
    else
        if next(ESPMap) or next(SkeletonMap) or next(BoxMap) or next(ChamsMap) then
            for plr in pairs(ESPMap) do KillESP(plr) end
            for plr in pairs(SkeletonMap) do KillSkelly(plr) end
            for plr in pairs(BoxMap) do KillBox(plr) end
            for plr in pairs(ChamsMap) do KillChams(plr) end
        end
    end

    if S.targetHud and stickyTarget then
        local ch = stickyTarget.Character
        if ch then
            local hu = ch:FindFirstChildOfClass("Humanoid")
            if hu and hu.Health > 0 then
                TargetHud.Visible = true
                THName.Text = stickyTarget.DisplayName
                local pct = math.clamp(hu.Health / math.max(1, hu.MaxHealth), 0, 1)
                THHpBar.Size = UDim2.new(pct, 0, 1, 0)
                THHpBar.BackgroundColor3 = Color3.new(1-pct, pct, 0.2)
                local root = ch:FindFirstChild("HumanoidRootPart")
                if root then
                    local d = (root.Position - Camera.CFrame.Position).Magnitude
                    THInfo.Text = string.format("%d HP  ·  %dm  ·  @%s",
                        math.floor(hu.Health), math.floor(d), stickyTarget.Name)
                end
            else
                TargetHud.Visible = false
            end
        else
            TargetHud.Visible = false
        end
    else
        TargetHud.Visible = false
    end

    if Watermark then
        Watermark.Visible = S.watermark
        if S.watermark then
            local parts = {"hanami v3.3.0"}
            if S.showFps then table.insert(parts, fpsVal.."fps") end
            if S.showPing then
                pcall(function()
                    local p = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                    table.insert(parts, p.."ms")
                end)
            end
            table.insert(parts, EffectiveEspHz().."hz esp")
            WmLabel.Text = table.concat(parts, "  ·  ")
        end
    end

    accText += dt
    if accText >= 0.25 then
        accText = 0
        local el = math.floor(os.clock() - sessionStart)
        local m = math.floor(el/60)
        local sec = el % 60
        local ts
        if m >= 60 then
            ts = string.format("◷ %dh %dm", math.floor(m/60), m%60)
        elseif m > 0 then
            ts = string.format("◷ %dm %ds", m, sec)
        else
            ts = string.format("◷ %ds on this server", sec)
        end
        STime.Text = ts
        SPlr.Text = "◉ "..#Players:GetPlayers().." / "..Players.MaxPlayers
    end
end))

