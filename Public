-- ============================================================
-- ADAPTIVE
-- ============================================================
local frameSamples = {}
local function RecordFrame(dt)
    table.insert(frameSamples, dt)
    if #frameSamples > 60 then table.remove(frameSamples, 1) end
end
local function AvgFrameTime()
    local s = 0
    for _, v in ipairs(frameSamples) do s += v end
    return s / math.max(1, #frameSamples)
end
local function EffectiveEspHz()
    local base = S.espRefresh
    if not S.adaptiveEsp then return base end
    if AvgFrameTime() > 0.025 then
        return math.max(S.adaptiveMinHz, math.floor(base * 0.5))
    end
    return base
end

-- ============================================================
-- ESP TICK
-- ============================================================
local function ColorForDistance(baseColor, d)
    if not S.distFade then return baseColor end
    local t = math.clamp(d / S.espDist, 0, 1)
    return Color3.new(t, 1 - t, 0.2)
end
local function TeamColor(plr)
    if not S.espTeamColor then return nil end
    local t = plr.Team
    if not t then return nil end
    return t.TeamColor and t.TeamColor.Color
end

local function TickESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if not S.esp then
                KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr)
                continue
            end
            local ch = plr.Character
            if not ch then
                KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr)
                continue
            end
            local root = ch:FindFirstChild("HumanoidRootPart")
                or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
            if not root then
                KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr)
                continue
            end
            local d = (root.Position - Camera.CFrame.Position).Magnitude
            if d > S.espDist then
                KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr)
                continue
            end

            if not ESPMap[plr] then MakeESP(plr) end
            local o = ESPMap[plr]
            if o then
                local col = TeamColor(plr) or S.espColor
                col = ColorForDistance(col, d)
                if o.hl then
                    o.hl.FillColor = col
                    o.hl.FillTransparency = S.espFill
                    o.hl.OutlineTransparency = S.espOutline
                end
                local pts = {}
                if S.names then table.insert(pts, plr.DisplayName) end
                if S.distEsp then table.insert(pts, "["..math.floor(d).."m]") end
                if S.hpEsp then
                    local hu = ch:FindFirstChildOfClass("Humanoid")
                    if hu then table.insert(pts, "HP "..math.floor(hu.Health)) end
                end
                o.txt.Text = table.concat(pts, "  ")
                if o.hpBg then
                    local hu = ch:FindFirstChildOfClass("Humanoid")
                    if hu and S.hpBar then
                        local pct = math.clamp(hu.Health / math.max(1, hu.MaxHealth), 0, 1)
                        o.hpBg.Visible = true
                        o.hpFg.Size = UDim2.new(1, 0, pct, 0)
                        o.hpFg.BackgroundColor3 = Color3.new(1 - pct, pct, 0.2)
                    else
                        o.hpBg.Visible = false
                    end
                end
                if o.tracer then
                    local scr, on = Camera:WorldToViewportPoint(root.Position)
                    if on then
                        local vp = Camera.ViewportSize
                        local fromX, fromY = vp.X/2, vp.Y
                        local toX, toY = scr.X, scr.Y
                        local dx, dy = toX - fromX, toY - fromY
                        local len = math.sqrt(dx*dx + dy*dy)
                        local ang = math.deg(math.atan2(dy, dx))
                        o.tracer.Size = UDim2.fromOffset(len, 1)
                        o.tracer.Position = UDim2.fromOffset(fromX, fromY)
                        o.tracer.Rotation = ang
                        o.tracer.BackgroundColor3 = col
                        o.tracer.Visible = true
                    else
                        o.tracer.Visible = false
                    end
                end
            end

            if S.skeleton then
                if not SkeletonMap[plr] then MakeSkelly(plr) end
                local lines = SkeletonMap[plr]
                if lines then
                    for _, ln in ipairs(lines) do
                        if ln.a and ln.a.Parent and ln.b and ln.b.Parent then
                            local from = ln.a.Position
                            local to = ln.b.Position
                            local dir = to - from
                            local dist = dir.Magnitude
                            if dist > 0.05 then
                                ln.line.Length = dist
                                ln.line.CFrame = CFrame.lookAt(from + dir * 0.5, to)
                                ln.line.Color3 = S.skeletonColor
                            end
                        end
                    end
                end
            else
                if SkeletonMap[plr] then KillSkelly(plr) end
            end

            if S.boxEsp then
                if not BoxMap[plr] then MakeBox(plr) end
                local frames = BoxMap[plr]
                if frames then
                    local topL = root.CFrame * Vector3.new(-1.5, 2.5, 0)
                    local botR = root.CFrame * Vector3.new(1.5, -2.5, 0)
                    local sTL, onTL = Camera:WorldToViewportPoint(topL)
                    local sBR, onBR = Camera:WorldToViewportPoint(botR)
                    if onTL and onBR then
                        local x1, y1 = sTL.X, sTL.Y
                        local x2, y2 = sBR.X, sBR.Y
                        local w = x2 - x1; local h = y2 - y1
                        frames[1].Position = UDim2.fromOffset(x1, y1)
                        frames[1].Size = UDim2.fromOffset(w, 1)
                        frames[2].Position = UDim2.fromOffset(x1, y1 + h)
                        frames[2].Size = UDim2.fromOffset(w, 1)
                        frames[3].Position = UDim2.fromOffset(x1, y1)
                        frames[3].Size = UDim2.fromOffset(1, h)
                        frames[4].Position = UDim2.fromOffset(x1 + w, y1)
                        frames[4].Size = UDim2.fromOffset(1, h)
                        local col = ColorForDistance(TeamColor(plr) or S.boxColor, d)
                        for _, f in ipairs(frames) do
                            f.BackgroundColor3 = col
                            f.Visible = true
                        end
                    else
                        for _, f in ipairs(frames) do f.Visible = false end
                    end
                end
            else
                if BoxMap[plr] then KillBox(plr) end
            end

            if S.chams then
                if not ChamsMap[plr] then MakeChams(plr) end
            else
                if ChamsMap[plr] then KillChams(plr) end
            end
        end
    end
end

