local ESPMap = {}
local SkeletonMap = {}
local BoxMap = {}
local ChamsMap = {}

function KillESP(plr)
    local o = ESPMap[plr]; if not o then return end
    if o.hl then o.hl:Destroy() end
    if o.bb then o.bb:Destroy() end
    if o.tracer then o.tracer:Destroy() end
    if o.hpFg then o.hpFg:Destroy() end
    if o.hpBg then o.hpBg:Destroy() end
    ESPMap[plr] = nil
end
function KillSkelly(plr)
    local list = SkeletonMap[plr]; if not list then return end
    for _, l in ipairs(list) do pcall(function() l.line:Destroy() end) end
    SkeletonMap[plr] = nil
end
function KillBox(plr)
    local o = BoxMap[plr]; if not o then return end
    for _, f in ipairs(o) do pcall(function() f:Destroy() end) end
    BoxMap[plr] = nil
end
function KillChams(plr)
    local o = ChamsMap[plr]; if not o then return end
    for part, orig in pairs(o) do
        pcall(function()
            if part and part.Parent then
                part.Material = orig.m
                part.Color = orig.c
            end
        end)
    end
    ChamsMap[plr] = nil
end

local function MakeESP(plr)
