local thumbCache = {}
local function GetThumb(uid)
    if thumbCache[uid] then return thumbCache[uid] end
    local img
    pcall(function()
        img = Players:GetUserThumbnailAsync(uid,
            Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    end)
    thumbCache[uid] = img
    return img
end

local function GetList(plr)
    if S.friends[plr.Name] then return "friend" end
    if S.blacklist[plr.Name] then return "blacklist" end
    if S.watchlist[plr.Name] then return "watch" end
    return "normal"
end
local function SetList(plr, state)
    S.friends[plr.Name] = nil
    S.blacklist[plr.Name] = nil
    S.watchlist[plr.Name] = nil
    if state == "friend" then S.friends[plr.Name] = true end
    if state == "blacklist" then S.blacklist[plr.Name] = true end
    if state == "watch" then S.watchlist[plr.Name] = true end
end

local function BuildFriends()
    for _,ch in ipairs(FList:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end
    for _,plr in ipairs(Players:GetPlayers()) do
        local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,
            Size=UDim2.new(1,0,0,46)},FList)
        Cr(row,8); local sk = Sk(row,C.border)
        local st = GetList(plr)
        if st == "friend" then sk.Color = C.green; sk.Transparency = 0.2
        elseif st == "blacklist" then sk.Color = C.red; sk.Transparency = 0.2
        elseif st == "watch" then sk.Color = C.yellow; sk.Transparency = 0.2 end

        local av=N("ImageLabel",{BackgroundColor3=C.card3,BorderSizePixel=0,
            Size=UDim2.fromOffset(32,32),Position=UDim2.fromOffset(7,7),Image=""},row)
        Cr(av,16)
        task.spawn(function()
            local img = GetThumb(plr.UserId)
            if img then av.Image = img end
        end)

        local nl=Lbl(row,plr.DisplayName,10,C.text,Enum.Font.GothamMedium)
        nl.Position=UDim2.fromOffset(48,7); nl.Size=UDim2.new(1,-58,0,16)
        nl.TextTruncate=Enum.TextTruncate.AtEnd

        local stateText = st:upper()
        local ul=Lbl(row,"@"..plr.Name.."  ·  "..stateText,8,C.sub)
        ul.Position=UDim2.fromOffset(48,25); ul.Size=UDim2.new(1,-58,0,12)
        ul.TextTruncate=Enum.TextTruncate.AtEnd

        local btn=N("TextButton",{BackgroundTransparency=1,Text="",
            Size=UDim2.fromScale(1,1),ZIndex=row.ZIndex+1},row)
        btn.Activated:Connect(function()
            local cur = GetList(plr)
            local nxt = "friend"
            if cur == "friend" then nxt = "blacklist"
            elseif cur == "blacklist" then nxt = "watch"
            elseif cur == "watch" then nxt = "normal" end
            SetList(plr, nxt)
            SaveFriends()
            BuildFriends()
            Toast(plr.DisplayName.." → "..nxt:upper(), C.accent)
        end)
    end
end
BuildFriends()
Track(Players.PlayerAdded:Connect(function() task.wait(0.2); BuildFriends() end))
Track(Players.PlayerRemoving:Connect(function() task.wait(0.2); BuildFriends() end))

