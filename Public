local trigLast = 0
local function TickTrigger()
    if not S.trigger then return end
    if S.trigHold and not Held() then return end
    local m = UIS:GetMouseLocation()
    local hit = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not S.friends[plr.Name] and not S.blacklist[plr.Name] then
            if not (S.trigTeam and Teammate(plr)) then
                local ch = plr.Character
                if ch and (not S.alive or Alive(ch)) then
                    local pt = Part(ch)
                    if pt then
                        local sc, vis = Camera:WorldToViewportPoint(pt.Position)
                        if vis and sc.Z > 0 then
                            local d = (Vector2.new(sc.X, sc.Y) - m).Magnitude
                            if d <= 6 and Visible(ch, pt) then
                                hit = true; break
                            end
                        end
                    end
                end
            end
        end
    end
    if hit then
        local now = os.clock()
        if now - trigLast >= (S.trigDelay / 1000) then
            trigLast = now
            task.spawn(function()
                pcall(function()
                    VU:CaptureController()
                    VU:ClickButton1(Vector2.new())
                end)
            end)
        end
    end
end

