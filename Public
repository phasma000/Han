        if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
        binding = false
        kbg.BackgroundColor3 = C.adk
        kl.Text = inp.KeyCode.Name
        if onBind then onBind(inp.KeyCode) end
    end))

    return row, {Set=function(_,kc) kl.Text = kc.Name end}
end

local function SliderRow(scr, nextOrder, title, min, max, def, key, isInt, fmt, onChange)
    local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,54),LayoutOrder=nextOrder()},scr)
    Cr(row,8); Sk(row,C.border)

    local tl=Lbl(row,title,10,C.text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(12,4); tl.Size=UDim2.new(1,-90,0,18)

    local valLbl=Lbl(row,"",9,C.accent,Enum.Font.GothamBold,Enum.TextXAlignment.Right)
    valLbl.Position=UDim2.new(1,-80,0,4); valLbl.Size=UDim2.fromOffset(68,18)

    local bg=N("Frame",{BackgroundColor3=C.card3,BorderSizePixel=0,
        Size=UDim2.new(1,-24,0,8),Position=UDim2.fromOffset(12,34)},row)
    Cr(bg,4)

    local fill=N("Frame",{BackgroundColor3=C.accent,BorderSizePixel=0,
        Size=UDim2.fromScale(0,1)},bg)
    Cr(fill,4)

    local knob=N("Frame",{BackgroundColor3=C.white,BorderSizePixel=0,
        Size=UDim2.fromOffset(14,14),AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.fromScale(0,.5),ZIndex=bg.ZIndex+1},bg)
    Cr(knob,7); Sk(knob,C.accent,2,0)

    local cur = def
    local function fmtV(v)
        if fmt then return fmt(v) end
        if isInt then return tostring(math.floor(v)) end
        return string.format("%.2f", v)
    end
    local function Rnd(v)
        v = math.clamp(v, min, max)
        if isInt then v = math.floor(v) end
        cur = v
        local pct = (v - min) / (max - min)
        fill.Size = UDim2.fromScale(pct, 1)
        knob.Position = UDim2.fromScale(pct, .5)
        valLbl.Text = fmtV(v)
        if key and S[key] ~= nil then S[key] = v end
        if onChange then onChange(v) end
    end
    Rnd(def)

    local dragging = false
    local function setFromX(x)
        local rel = (x - bg.AbsolutePosition.X) / bg.AbsoluteSize.X
        Rnd(min + rel * (max - min))
    end
    local grab = N("TextButton",{BackgroundTransparency=1,Text="",
        Size=UDim2.new(1,0,1,14),Position=UDim2.new(0,0,0.5,-7),
        ZIndex=knob.ZIndex+1},bg)
    grab.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setFromX(inp.Position.X)
        end
    end)
    Track(UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            setFromX(inp.Position.X)
        end
    end))
    Track(UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return row, {Set=function(_,v) Rnd(v) end, Get=function() return cur end}
end

