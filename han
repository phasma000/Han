-- Full-width setting row: toggle
local function RowToggle(parent, yOff, title, sub, init, cb)
    local row = New("Frame", {
        BackgroundColor3 = Theme.Card,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, -16, 0, sub and 64 or 48),
        Position         = UDim2.fromOffset(8, yOff),
    }, parent)
    Corner(row, 8)
    Stroke(row, Theme.Border)

    -- small circle indicator
    local circ = New("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Size     = UDim2.fromOffset(10, 10),
        Position = UDim2.fromOffset(12, sub and 27 or 19),
    }, row)
    Corner(circ, 5)
    Stroke(circ, Theme.Dim)

    local tLbl = Lbl(row, title, 10, Theme.Text, Enum.Font.GothamMedium)
    tLbl.Position = UDim2.fromOffset(30, sub and 10 or 0)
    tLbl.Size     = UDim2.new(1, -90, 0, 22)

    if sub then
        local sLbl = Lbl(row, sub, 8, Theme.Sub)
        sLbl.Position = UDim2.fromOffset(30, 30)
        sLbl.Size     = UDim2.new(1, -90, 0, 28)
        sLbl.TextYAlignment = Enum.TextYAlignment.Top
        sLbl.TextWrapped    = true
    end

    -- pill toggle right side
    local TW, TH = 50, 26
    local bg = New("Frame", {
        BackgroundColor3 = init and Theme.Accent or Theme.Card3,
        BorderSizePixel  = 0,
        Size             = UDim2.fromOffset(TW, TH),
        Position         = UDim2.new(1, -(TW+12), 0.5, -TH/2),
    }, row)
    Corner(bg, TH)
    local knob = New("Frame", {
        BackgroundColor3 = Theme.White,
        BorderSizePixel  = 0,
        Size             = UDim2.fromOffset(20, 20),
        Position         = init and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3),
    }, bg)
    Corner(knob, 10)

    local on = init == true
    local function Render(v)
        Tw(bg,   { BackgroundColor3 = v and Theme.Accent or Theme.Card3 }, 0.14):Play()
        Tw(knob, { Position = v and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3) }, 0.14):Play()
    end
    local btn = New("TextButton", {
        BackgroundTransparency = 1, Text = "",
        Size = UDim2.fromScale(1,1), ZIndex = bg.ZIndex+1,
    }, bg)
    btn.Activated:Connect(function()
        on = not on; Render(on); if cb then cb(on) end
    end)

    return {
        Set = function(_, v) on = v; Render(v) end,
        Get = function() return on end,
        Row = row,
    }
end

-- Full-width setting row: pill selector
local function RowPillSel(parent, yOff, title, opts, def, cb)
    local row = New("Frame", {
        BackgroundColor3 = Theme.Card,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, -16, 0, 56),
        Position         = UDim2.fromOffset(8, yOff),
    }, parent)
    Corner(row, 8)
    Stroke(row, Theme.Border)

    local tLbl = Lbl(row, title, 10, Theme.Text, Enum.Font.GothamMedium)
    tLbl.Position = UDim2.fromOffset(12, 4)
    tLbl.Size     = UDim2.new(1, -16, 0, 20)

    local totalW = (#opts * 68) + (#opts-1)*4
    local selRow = New("Frame", {
        BackgroundTransparency = 1,
        Size     = UDim2.fromOffset(totalW, 28),
        Position = UDim2.new(1, -(totalW+12), 1, -36),
    }, row)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding       = UDim.new(0, 4),
    }, selRow)

    local cur = def
    local btns = {}
    local function Upd()
        for _, b in ipairs(btns) do
            local sel = b.Name == cur
            Tw(b, { BackgroundColor3 = sel and Theme.Accent or Theme.Card3 }, 0.12):Play()
            b.TextColor3 = sel and Theme.White or Theme.Sub
        end
    end
    for _, opt in ipairs(opts) do
        local b = New("TextButton", {
            Name             = opt,
            BackgroundColor3 = opt==def and Theme.Accent or Theme.Card3,
            BorderSizePixel  = 0,
            Text             = opt,
            TextColor3       = opt==def and Theme.White or Theme.Sub,
            TextSize         = 8,
            Font             = Enum.Font.GothamBold,
            Size             = UDim2.fromOffset(68, 28),
            AutoButtonColor  = false,
        }, selRow)
        Corner(b, 6)
        table.insert(btns, b)
        b.Activated:Connect(function() cur=opt; Upd(); if cb then cb(opt) end end)
    end
    return row
end

