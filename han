-- GAMEPLAY
-- ============================================================
local function Alive(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end
local function Teammate(plr)
    if not S.team then return false end
    if not LP.Team or not plr.Team then return false end
    return LP.Team == plr.Team
end
local function Part(char)
    local p = char:FindFirstChild(S.hitboxPart)
    if p and p:IsA("BasePart") then return p end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function Visible(char, part)
    if not S.wall then return true end
    rayParams.FilterDescendantsInstances = {LP.Character}
    local r = WS:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rayParams)
    return not r or r.Instance:IsDescendantOf(char)
end
local function ThreatScore(plr)
    local ch = plr.Character; if not ch then return 0 end
    local head = ch:FindFirstChild("Head"); if not head then return 0 end
    local toMe = Camera.CFrame.Position - head.Position
    if toMe.Magnitude < 0.1 then return 0 end
    return math.clamp(head.CFrame.LookVector:Dot(toMe.Unit), -1, 1)
end
local function ScoreTarget(plr, ch, pt, screenD, worldD)
    local mode = S.targetPriority
    if mode == "Closest" then return worldD end
    if mode == "LowestHP" then
        local hu = ch:FindFirstChildOfClass("Humanoid")
        return hu and hu.Health or 999
    end
    if mode == "Threat" then return -ThreatScore(plr) end
    return screenD
end

local stickyTarget, stickySince = nil, 0
local function Target(ignoreSticky)
    local m = UIS:GetMouseLocation()
    local best, bestScore, bestPart = nil, math.huge, nil
    if S.stickyLock and stickyTarget and not ignoreSticky then
        local stCh = stickyTarget.Character
        if stCh and (not S.alive or Alive(stCh))
        and not S.friends[stickyTarget.Name]
        and not S.blacklist[stickyTarget.Name]
        and not Teammate(stickyTarget) then
            local stPart = Part(stCh)
            if stPart then
                local d = (stPart.Position - Camera.CFrame.Position).Magnitude
                if d <= S.dist then
                    local sc, vis = Camera:WorldToViewportPoint(stPart.Position)
                    if vis and sc.Z > 0 then
                        local cd = (Vector2.new(sc.X, sc.Y) - m).Magnitude
                        if cd <= S.fov and (os.clock() - stickySince) < S.stickyTime*3 then
                            return stPart, stickyTarget
                        end
                    end
                end
            end
        end
        stickyTarget = nil
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not Teammate(plr)
        and not S.friends[plr.Name] and not S.blacklist[plr.Name] then
            local ch = plr.Character
            if ch and (not S.alive or Alive(ch)) then
                local pt = Part(ch)
                if pt then
                    local worldD = (pt.Position - Camera.CFrame.Position).Magnitude
                    if worldD <= S.dist then
                        local sc, vis = Camera:WorldToViewportPoint(pt.Position)
                        if vis and sc.Z > 0 then
                            local screenD = (Vector2.new(sc.X, sc.Y) - m).Magnitude
                            if screenD <= S.fov then
                                if Visible(ch, pt) then
                                    local score = ScoreTarget(plr, ch, pt, screenD, worldD)
                                    if score < bestScore then
                                        bestScore = score; best = plr; bestPart = pt
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if best then
        if stickyTarget ~= best then stickyTarget = best; stickySince = os.clock() end
        return bestPart, best
    end
    return nil
end

local reactionArmed = false
local reactionStart = 0
local function ReactionReady()
    if not S.humanDelay then return true end
    local now = os.clock()
    if not reactionArmed then
        reactionArmed = true
        reactionStart = now + math.random(S.humanDelayMin, S.humanDelayMax)/1000
        return false
    end
    return now >= reactionStart
end
local function ReactionReset() reactionArmed = false end

