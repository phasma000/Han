-- ============================================================
-- DRAG
-- ============================================================
local Drag,DragStart,DragPos=false,nil,nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1
    or input.UserInputType==Enum.UserInputType.Touch then
        Drag=true; DragStart=input.Position; DragPos=Main.Position
        input.Changed:Connect(function()
            if input.UserInputState==Enum.UserInputState.End then Drag=false end
        end)
    end
end)
UIS.InputChanged:Connect(function(input)
    if not Drag then return end
    if input.UserInputType==Enum.UserInputType.MouseMovement
    or input.UserInputType==Enum.UserInputType.Touch then
        local d=input.Position-DragStart
        Main.Position=UDim2.new(DragPos.X.Scale,DragPos.X.Offset+d.X,
            DragPos.Y.Scale,DragPos.Y.Offset+d.Y)
    end
end)

-- ============================================================
-- RENDER LOOP
-- ============================================================
local SessionStart=os.clock()

RS.RenderStepped:Connect(function(dt)
    local elapsed=math.floor(os.clock()-SessionStart)
    TimeLbl.Text="🕐 "..math.floor(elapsed/60).."m on this server"
    PlrLbl.Text="👤 "..#Players:GetPlayers().." / 22"

    FOVOverlay.Size=UDim2.fromOffset(S.FOV*2,S.FOV*2)
    FOVOverlay.Visible=S.ShowFOV and S.AimAssist

    if FOVRing then
        local ringPx=math.clamp(S.FOV/500*88,18,88)
        FOVRing.Size=UDim2.fromOffset(ringPx*2,ringPx*2)
    end

    if AimStatusLbl then
        AimStatusLbl.Text=S.AimAssist and "ready" or "searching"
    end

    if S.AimAssist and (S.AimHeld or not S.HoldKeyOnly) then
        local tgt=GetTarget()
        if AimStatusLbl then AimStatusLbl.Text=tgt and "locking" or "searching" end
        if tgt then
            local desired=CFrame.lookAt(Camera.CFrame.Position,tgt.Position)
            local alpha=math.clamp(S.Smoothness*6*dt,0.01,0.5)
            Camera.CFrame=Camera.CFrame:Lerp(desired,alpha)
        end
    end

    if S.ESP then TickESP() end
end)

