-- ============================================================
-- HELPERS
-- ============================================================
local function New(cls, props, parent)
    local o = Instance.new(cls)
    for k,v in pairs(props or {}) do pcall(function() o[k]=v end) end
    o.Parent = parent
    return o
end
local function Corner(p,r) return New("UICorner",{CornerRadius=UDim.new(0,r or 6)},p) end
local function Stroke(p,col,thick,trans)
    return New("UIStroke",{Color=col or T.Border,Thickness=thick or 1,Transparency=trans or 0},p)
end
local function Tw(obj,props,dur,sty,dir)
    return TS:Create(obj,TweenInfo.new(dur or .18,sty or Enum.EasingStyle.Quart,dir or Enum.EasingDirection.Out),props)
end
local function Lbl(parent,text,size,color,font,xa)
    return New("TextLabel",{
        BackgroundTransparency=1, Text=text or "",
        TextColor3=color or T.Text, TextSize=size or 11,
        Font=font or Enum.Font.Gotham,
        TextXAlignment=xa or Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,
        TextWrapped=true,
    },parent)
end

