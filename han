-- Toggle row
local togRefs = {}
local function TogRow(scr,ord,title,sub,init,key)
    local h = sub and 66 or 50
    local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,h),LayoutOrder=ord},scr)
    Cr(row,8); Sk(row,C.border)

    -- ring indicator
    local ring=N("Frame",{BackgroundTransparency=1,BorderSizePixel=0,
        Size=UDim2.fromOffset(10,10),
        Position=UDim2.fromOffset(12, sub and 28 or 20)},row)
    Cr(ring,5); Sk(ring,C.dim)

    local tl=Lbl(row,title,10,C.text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(30, sub and 10 or 0)
    tl.Size=UDim2.new(1,-88,0,22)

    if sub then
        local sl=Lbl(row,sub,8,C.sub)
        sl.Position=UDim2.fromOffset(30,30)
        sl.Size=UDim2.new(1,-88,0,32)
        sl.TextYAlignment=Enum.TextYAlignment.Top
        sl.TextWrapped=true
    end

    local TW,TH=50,26
    local bg=N("Frame",{
        BackgroundColor3=init and C.accent or C.card3,BorderSizePixel=0,
        Size=UDim2.fromOffset(TW,TH),
        Position=UDim2.new(1,-(TW+10),0.5,-TH/2),
    },row); Cr(bg,TH)
    local knob=N("Frame",{BackgroundColor3=C.white,BorderSizePixel=0,
        Size=UDim2.fromOffset(20,20),
        Position=init and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3),
    },bg); Cr(knob,10)

    local on=init==true
    local function Rnd(v)
        Tw(bg,{BackgroundColor3=v and C.accent or C.card3},.14)
        Tw(knob,{Position=v and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3)},.14)
        if S[key]~=nil then S[key]=v end
    end
    local btn=N("TextButton",{BackgroundTransparency=1,Text="",
        Size=UDim2.fromScale(1,1),ZIndex=bg.ZIndex+1},bg)
    btn.Activated:Connect(function() on=not on; Rnd(on) end)

    local ref={Set=function(_,v) on=v;Rnd(v) end,Get=function() return on end}
    if key then togRefs[key]=ref end
    return row,ref
end

-- Pill selector row
local function PillRow(scr,ord,title,opts,def,key)
    local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,58),LayoutOrder=ord},scr)
    Cr(row,8); Sk(row,C.border)

    local tl=Lbl(row,title,10,C.text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(12,4); tl.Size=UDim2.new(1,-16,0,20)

    local totalW = CONT - PAD*2 - 24
    local pW = math.floor((totalW-(#opts-1)*4)/#opts)
    pW = math.clamp(pW,46,120)

    local pRow=N("Frame",{BackgroundTransparency=1,
        Size=UDim2.new(1,-24,0,28),Position=UDim2.fromOffset(12,26)},row)
    N("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,4)},pRow)

    local cur=def; local bs={}
    local function Upd()
        for _,b in ipairs(bs) do
            local sel=b.Name==cur
            Tw(b,{BackgroundColor3=sel and C.accent or C.card3},.12)
            b.TextColor3=sel and C.white or C.sub
        end
        if key then S[key]=cur end
    end
    for _,opt in ipairs(opts) do
        local b=N("TextButton",{Name=opt,
            BackgroundColor3=opt==def and C.accent or C.card3,
            BorderSizePixel=0,Text=opt,
            TextColor3=opt==def and C.white or C.sub,
            TextSize=8,Font=Enum.Font.GothamBold,
            Size=UDim2.fromOffset(pW,28),AutoButtonColor=false},pRow)
        Cr(b,6); table.insert(bs,b)
        b.Activated:Connect(function() cur=opt;Upd() end)
    end
    return row
end

