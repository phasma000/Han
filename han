            S.mobBtnY = math.clamp(inp.Position.Y / vp.Y, 0.05, 0.95)
            MobBtn.Position = UDim2.new(S.mobBtnX, 0, S.mobBtnY, 0)
        end
    end
end))
MobBtn.InputEnded:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.Touch or inp.UserInputType==Enum.UserInputType.MouseButton1 then
        local dragged = mobStartPos and (inp.Position - mobStartPos).Magnitude > 12
        mobStartPos = nil
        if not dragged then
            if S.mobileBtnMode == "Hold" then
                S.heldMobile = true; RefreshAimStates()
            else
                S.heldMobile = not S.heldMobile; RefreshAimStates()
            end
        end
    end
end)
