-- ============================================================
-- GAMEPLAY
-- ============================================================
local function IsAlive(char)
    local h = char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health > 0
end

local function IsTeammate(plr)
    if not S.TeamCheck then return false end
    if not LP.Team or not plr.Team then return false end
    return LP.Team == plr.Team
end

local function GetPart(char)
    local p = char:FindFirstChild(S.TargetPart)
    if p and p:IsA("BasePart") then return p end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function IsVisible(char, part)
    if not S.WallCheck then return true end
    local origin = Camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { LP.Character }
    local res = Workspace:Raycast(origin, part.Position - origin, params)
    if not res then return true end
    return res.Instance:IsDescendantOf(char)
end

local function GetTarget()
    local mouse = UIS:GetMouseLocation()
    local best, bestD = nil, S.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and not IsTeammate(plr) and not S.FriendsList[plr.Name] then
            local char = plr.Character
            if char and (not S.AliveCheck or IsAlive(char)) then
                local part = GetPart(char)
                if part then
                    local dist = (part.Position - Camera.CFrame.Position).Magnitude
                    if dist <= S.Distance then
                        local sc, vis = Camera:WorldToViewportPoint(part.Position)
                        if vis and sc.Z > 0 then
                            local cd = (Vector2.new(sc.X, sc.Y) - mouse).Magnitude
                            if cd <= bestD and IsVisible(char, part) then
                                bestD = cd; best = part
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- ESP
-- ============================================================
local ESPMap = {}

local function KillESP(plr)
    local o = ESPMap[plr]; if not o then return end
    if o.hl then o.hl:Destroy() end
    if o.bb then o.bb:Destroy() end
    ESPMap[plr] = nil
end

local function MakeESP(plr)
    if plr == LP then return end
    KillESP(plr)
    local char = plr.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
    if not root then return end

    local hl = New("Highlight", {
        FillColor           = Theme.Accent,
        OutlineColor        = Theme.White,
        FillTransparency    = 0.78,
        OutlineTransparency = 0.25,
        DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop,
        Adornee             = char,
    }, char)

    local bb = New("BillboardGui", {
        Adornee     = root,
        Size        = UDim2.fromOffset(180, 35),
        StudsOffset = Vector3.new(0, 3.2, 0),
        AlwaysOnTop = true,
    }, root)
    local txt = Lbl(bb, "", 8, Theme.White, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
    txt.Size = UDim2.fromScale(1, 1)
    txt.TextXAlignment = Enum.TextXAlignment.Center

    ESPMap[plr] = { hl = hl, bb = bb, txt = txt }
end

local function TickESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if not S.ESP then KillESP(plr)
            else
                local char = plr.Character
                if not char then KillESP(plr); continue end
                local root = char:FindFirstChild("HumanoidRootPart")
                    or char:FindFirstChild("UpperTorso")
                    or char:FindFirstChild("Torso")
                if not root then KillESP(plr); continue end
                local dist = (root.Position - Camera.CFrame.Position).Magnitude
                if dist > S.ESPDistance then KillESP(plr); continue end
                if not ESPMap[plr] then MakeESP(plr) end
                local o = ESPMap[plr]
                if o then
                    o.hl.FillColor = Theme.Accent
                    local parts = {}
                    if S.Names       then table.insert(parts, plr.DisplayName) end
                    if S.DistanceESP then table.insert(parts, "["..math.floor(dist).."m]") end
                    if S.HealthESP   then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then table.insert(parts, "HP "..math.floor(hum.Health)) end
                    end
                    o.txt.Text = table.concat(parts, "  ")
                end
            end
        end
    end
end

