-- Swatch row
local function SwatchRow(scr,ord,title,colors,def,key)
    local cols=4; local sw=26; local gap=6
    local rows=math.ceil(#colors/cols)
    local rh=22+rows*(sw+gap)+8
    local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,rh),LayoutOrder=ord},scr)
    Cr(row,8); Sk(row,C.border)
    local tl=Lbl(row,title,10,C.text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(12,4); tl.Size=UDim2.new(1,-16,0,18)
    local sel=def; local all={}
    for i,col in ipairs(colors) do
        local cx=(i-1)%cols; local cy=math.floor((i-1)/cols)
        local f=N("Frame",{BackgroundColor3=col,BorderSizePixel=0,
            Size=UDim2.fromOffset(sw,sw),
            Position=UDim2.fromOffset(12+cx*(sw+gap),26+cy*(sw+gap))},row)
        Cr(f,5)
        local st=N("UIStroke",{Color=C.white,Thickness=2,Transparency=col==def and 0.1 or 0.9},f)
        local btn=N("TextButton",{BackgroundTransparency=1,Text="",
            Size=UDim2.fromScale(1,1),ZIndex=f.ZIndex+1},f)
        table.insert(all,{st=st,col=col})
        btn.Activated:Connect(function()
            sel=col
            for _,s in ipairs(all) do
                Tw(s.st,{Transparency=s.col==col and 0.1 or 0.9},.1)
            end
            if key then S[key]=col end
        end)
    end
    return row
end

