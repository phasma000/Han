-- Color swatch row
local function RowSwatches(scr,order,title,colors,def,cb)
    local cols=4
    local sw=26; local gap=6
    local rows=math.ceil(#colors/cols)
    local h=22+rows*(sw+gap)+6
    local row=New("Frame",{
        BackgroundColor3=T.Card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,h),LayoutOrder=order,
    },scr); Corner(row,8); Stroke(row,T.Border)
    local tl=Lbl(row,title,10,T.Text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(12,4); tl.Size=UDim2.new(1,-16,0,18)
    local selected=def; local all={}
    for i,col in ipairs(colors) do
        local c=(i-1)%cols; local r=math.floor((i-1)/cols)
