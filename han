local function N(cls,p,par)
    local o=Instance.new(cls)
    for k,v in pairs(p or {}) do o[k]=v end
    o.Parent=par; return o
end
local function Cr(o,r) N("UICorner",{CornerRadius=UDim.new(0,r or 6)},o) end
local function Sk(o,col,th,tr)
    return N("UIStroke",{Color=col or C.border,Thickness=th or 1,Transparency=tr or 0},o)
end
local function Tw(o,p,d,s,e)
    if not S.animsOn then
        for k,v in pairs(p) do pcall(function() o[k]=v end) end
        return
    end
    TS:Create(o,TweenInfo.new(d or .16,s or Enum.EasingStyle.Quart,e or Enum.EasingDirection.Out),p):Play()
end
local function Lbl(par,txt,sz,col,font,xa)
    return N("TextLabel",{
        BackgroundTransparency=1,Text=txt or "",
        TextColor3=col or C.text,TextSize=sz or 11,
        Font=font or Enum.Font.Gotham,
        TextXAlignment=xa or Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Center,
        TextWrapped=true,
    },par)
end
local function CurveAlpha(t, mode)
    if mode == "Linear" then return t end
    if mode == "EaseIn" then return t*t end
    if mode == "EaseOut" then return 1-(1-t)*(1-t) end
    if mode == "SCurve" then return t*t*(3-2*t) end
    return t
end
local function ColorToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5))
end
local function HexToColor(h)
    h = h:gsub("#","")
    if #h ~= 6 then return nil end
    local r = tonumber(h:sub(1,2),16)
    local g = tonumber(h:sub(3,4),16)
    local b = tonumber(h:sub(5,6),16)
    if not r or not g or not b then return nil end
    return Color3.fromRGB(r,g,b)
end
local function ColorToHSV(c)
    return Color3.toHSV(c)
end
local function HSVToColor(h,s,v)
    return Color3.fromHSV(h,s,v)
end

