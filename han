-- GAMEPLAY
-- ============================================================
local function Alive(char)
    local h=char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health>0
end
local function Teammate(plr)
    if not S.team then return false end
    if not LP.Team or not plr.Team then return false end
    return LP.Team==plr.Team
end
local function Part(char)
    local p=char:FindFirstChild(S.part)
    if p and p:IsA("BasePart") then return p end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end
local function Visible(char,part)
    if not S.wall then return true end
    local pr=RaycastParams.new()
    pr.FilterType=Enum.RaycastFilterType.Exclude
    pr.FilterDescendantsInstances={LP.Character}
    local r=WS:Raycast(Camera.CFrame.Position,part.Position-Camera.CFrame.Position,pr)
    return not r or r.Instance:IsDescendantOf(char)
end
local function Target()
    local m=UIS:GetMouseLocation()
    local best,bd=nil,S.fov
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and not Teammate(plr) and not S.friends[plr.Name] then
            local ch=plr.Character
            if ch and (not S.alive or Alive(ch)) then
                local pt=Part(ch)
                if pt then
                    local d=(pt.Position-Camera.CFrame.Position).Magnitude
                    if d<=S.dist then
                        local sc,vis=Camera:WorldToViewportPoint(pt.Position)
                        if vis and sc.Z>0 then
                            local cd=(Vector2.new(sc.X,sc.Y)-m).Magnitude
                            if cd<=bd and Visible(ch,pt) then bd=cd;best=pt end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- ESP
local ESPMap={}
local function KillESP(plr)
    local o=ESPMap[plr];if not o then return end
    if o.hl then o.hl:Destroy() end
    if o.bb then o.bb:Destroy() end
    ESPMap[plr]=nil
end
local function MakeESP(plr)
    if plr==LP then return end; KillESP(plr)
    local ch=plr.Character;if not ch then return end
    local root=ch:FindFirstChild("HumanoidRootPart")
        or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    if not root then return end
    local hl=N("Highlight",{FillColor=C.accent,OutlineColor=C.white,
        FillTransparency=0.78,OutlineTransparency=0.25,
        DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Adornee=ch},ch)
    local bb=N("BillboardGui",{Adornee=root,
        Size=UDim2.fromOffset(180,32),StudsOffset=Vector3.new(0,3,0),
        AlwaysOnTop=true},root)
    local txt=Lbl(bb,"",8,C.white,Enum.Font.GothamBold,Enum.TextXAlignment.Center)
    txt.Size=UDim2.fromScale(1,1); txt.TextXAlignment=Enum.TextXAlignment.Center
    ESPMap[plr]={hl=hl,bb=bb,txt=txt}
end
local function TickESP()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            if not S.esp then KillESP(plr); continue end
            local ch=plr.Character
            if not ch then KillESP(plr); continue end
            local root=ch:FindFirstChild("HumanoidRootPart")
                or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
            if not root then KillESP(plr); continue end
            local d=(root.Position-Camera.CFrame.Position).Magnitude
            if d>S.espDist then KillESP(plr); continue end
            if not ESPMap[plr] then MakeESP(plr) end
            local o=ESPMap[plr]
            if o then
                o.hl.FillColor=C.accent
                local pts={}
                if S.names then table.insert(pts,plr.DisplayName) end
                if S.distEsp then table.insert(pts,"["..math.floor(d).."m]") end
                if S.hpEsp then
                    local hu=ch:FindFirstChildOfClass("Humanoid")
                    if hu then table.insert(pts,"HP "..math.floor(hu.Health)) end
                end
                o.txt.Text=table.concat(pts,"  ")
            end
        end
    end
end
