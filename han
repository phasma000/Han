    local knob=New("Frame",{
        BackgroundColor3=T.White,BorderSizePixel=0,
        Size=UDim2.fromOffset(20,20),
        Position=init and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3),
    },bg); Corner(knob,10)
    local on=init==true
    local function Rnd(v)
        Tw(bg,{BackgroundColor3=v and T.Accent or T.Card3},.14):Play()
        Tw(knob,{Position=v and UDim2.fromOffset(27,3) or UDim2.fromOffset(3,3)},.14):Play()
    end
    local btn=New("TextButton",{BackgroundTransparency=1,Text="",
        Size=UDim2.fromScale(1,1),ZIndex=bg.ZIndex+1},bg)
    btn.Activated:Connect(function() on=not on; Rnd(on); if cb then cb(on) end end)
    return {Set=function(_,v) on=v;Rnd(v) end,Get=function() return on end,Row=row}
end

-- Pill selector row
local function RowPillSel(scr,order,title,opts,def,cb)
    local row=New("Frame",{
        BackgroundColor3=T.Card,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,58),LayoutOrder=order,
    },scr); Corner(row,8); Stroke(row,T.Border)

    local tl=Lbl(row,title,10,T.Text,Enum.Font.GothamMedium)
    tl.Position=UDim2.fromOffset(12,4); tl.Size=UDim2.new(1,-16,0,20)

    local optW = math.floor((CONTENT_W - ROW_PAD*2 - 24 - (#opts-1)*4) / #opts)
    optW = math.clamp(optW,48,110)

    local selRow=New("Frame",{BackgroundTransparency=1,
        Size=UDim2.new(1,-24,0,28),Position=UDim2.fromOffset(12,26)},row)
    New("UIListLayout",{FillDirection=Enum.FillDirection.Horizontal,Padding=UDim.new(0,4)},selRow)

    local cur=def; local btns={}
    local function Upd()
        for _,b in ipairs(btns) do
            local sel=b.Name==cur
            Tw(b,{BackgroundColor3=sel and T.Accent or T.Card3},.12):Play()
            b.TextColor3=sel and T.White or T.Sub
        end
    end
    for _,opt in ipairs(opts) do
        local b=New("TextButton",{Name=opt,
            BackgroundColor3=opt==def and T.Accent or T.Card3,
            BorderSizePixel=0,Text=opt,
            TextColor3=opt==def and T.White or T.Sub,
            TextSize=8,Font=Enum.Font.GothamBold,
            Size=UDim2.fromOffset(optW,28),AutoButtonColor=false,
        },selRow); Corner(b,6); table.insert(btns,b)
        b.Activated:Connect(function() cur=opt;Upd();if cb then cb(opt) end end)
    end
    return row
end

