    for _,ch in ipairs(FList:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
    for _,plr in ipairs(Players:GetPlayers()) do
        local row=N("Frame",{BackgroundColor3=C.card,BorderSizePixel=0,Size=UDim2.new(1,0,0,46)},FList)
        Cr(row,8); local sk = Sk(row,C.border)
