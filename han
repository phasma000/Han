local ESPMap = {}
local SkeletonMap = {}
local BoxMap = {}
local ChamsMap = {}

function KillESP(plr)
    local o = ESPMap[plr]; if not o then return end
    if o.hl then o.hl:Destroy() end
    if o.bb then o.bb:Destroy() end
    if o.tracer then o.tracer:Destroy() end
    if o.hpFg then o.hpFg:Destroy() end
    if o.hpBg then o.hpBg:Destroy() end
    ESPMap[plr] = nil
end
function KillSkelly(plr)
    local l = SkeletonMap[plr]; if not l then return end
    for _, x in ipairs(l) do pcall(function() x.line:Destroy() end) end
    SkeletonMap[plr] = nil
end
function KillBox(plr)
    local f = BoxMap[plr]; if not f then return end
    for _, x in ipairs(f) do pcall(function() x:Destroy() end) end
    BoxMap[plr] = nil
end
function KillChams(plr)
    local o = ChamsMap[plr]; if not o then return end
    for part, orig in pairs(o) do
        pcall(function()
            if part and part.Parent then
                part.Material = orig.m; part.Color = orig.c
            end
        end)
    end
    ChamsMap[plr] = nil
end

local function MakeESP(plr)
    if plr == LP then return end
    KillESP(plr)
    local ch = plr.Character; if not ch then return end
    local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
    if not root then return end
    local hl
    if S.glowOn and S.boxStyle ~= "None" then
        hl = N("Highlight",{FillColor=S.espColor,OutlineColor=C.white,
            FillTransparency=S.espFill,OutlineTransparency=S.espOutline,
            DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Adornee=ch},ch)
    end
    local bb = N("BillboardGui",{Adornee=root,Size=UDim2.fromOffset(180,32),
        StudsOffset=Vector3.new(0,3,0),AlwaysOnTop=true},root)
    local txt = Lbl(bb,"",8,C.white,Enum.Font.GothamBold,Enum.TextXAlignment.Center)
    txt.Size=UDim2.fromScale(1,1); txt.TextXAlignment=Enum.TextXAlignment.Center
    local hpBg, hpFg
    if S.hpBar then
        hpBg = N("Frame",{BackgroundColor3=Color3.fromRGB(20,20,20),BorderSizePixel=0,
            Size=UDim2.fromOffset(4,30),Position=UDim2.new(0,-8,0,1),BackgroundTransparency=0.3},bb)
        Cr(hpBg,2)
        hpFg = N("Frame",{BackgroundColor3=C.green,BorderSizePixel=0,
            Size=UDim2.new(1,0,1,0),Position=UDim2.new(0,0,1,-1),AnchorPoint=Vector2.new(0,1)},hpBg)
        Cr(hpFg,2)
    end
    local tracer
    if S.tracers then
        tracer = N("Frame",{BackgroundColor3=S.espColor,BorderSizePixel=0,
            Size=UDim2.new(0,0,0,0),Visible=false},Screen)
    end
    ESPMap[plr] = {hl=hl, bb=bb, txt=txt, hpBg=hpBg, hpFg=hpFg, tracer=tracer}
end

local SKEL_JOINTS = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local function MakeSkelly(plr)
    if plr == LP then return end
    KillSkelly(plr)
    local ch = plr.Character; if not ch then return end
    local lines = {}
    for _, pair in ipairs(SKEL_JOINTS) do
        local a = ch:FindFirstChild(pair[1]); local b = ch:FindFirstChild(pair[2])
        if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
            local ln = N("LineHandleAdornment",{
                Adornee=a, Thickness=1.5, Color3=S.skeletonColor,
                Transparency=0.2, AlwaysOnTop=true, ZIndex=20,
            },a)
            table.insert(lines, {line=ln, a=a, b=b})
        end
    end
    SkeletonMap[plr] = lines
end
local function MakeBox(plr)
    if plr == LP then return end
    KillBox(plr)
    local frames = {}
    for i=1,4 do
        local f = N("Frame",{BackgroundColor3=S.boxColor,BorderSizePixel=0,Visible=false},Screen)
        table.insert(frames, f)
    end
    BoxMap[plr] = frames
end
local function MakeChams(plr)
    if plr == LP then return end
    KillChams(plr)
    local ch = plr.Character; if not ch then return end
    local orig = {}
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then
            orig[p] = {m=p.Material, c=p.Color}
            pcall(function() p.Material = Enum.Material.ForceField; p.Color = S.chamsColor end)
        end
    end
    ChamsMap[plr] = orig
end

local frameSamples = {}
local function RecordFrame(dt)
    table.insert(frameSamples, dt)
    if #frameSamples > 60 then table.remove(frameSamples, 1) end
end
local function AvgFrameTime()
    local s = 0
    for _, v in ipairs(frameSamples) do s += v end
    return s / math.max(1, #frameSamples)
end
local function EffectiveEspHz()
    local base = S.espRefresh
    if not S.adaptiveEsp then return base end
    if AvgFrameTime() > 0.025 then
        return math.max(S.adaptiveMinHz, math.floor(base * 0.5))
    end
    return base
end

local function ColorForDistance(baseColor, d)
    if not S.distFade then return baseColor end
    local t = math.clamp(d / S.espDist, 0, 1)
    return Color3.new(t, 1 - t, 0.2)
end
local function TeamColor(plr)
    if not S.espTeamColor then return nil end
    local t = plr.Team; if not t then return nil end
    return t.TeamColor and t.TeamColor.Color
end

local function TickESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            if not S.esp then
                KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr)
                continue
            end
            local ch = plr.Character
            if not ch then KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr); continue end
            local root = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
            if not root then KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr); continue end
            local d = (root.Position - Camera.CFrame.Position).Magnitude
            if d > S.espDist then KillESP(plr); KillSkelly(plr); KillBox(plr); KillChams(plr); continue end

            if not ESPMap[plr] then MakeESP(plr) end
            local o = ESPMap[plr]
            if o then
                local col = ColorForDistance(TeamColor(plr) or S.espColor, d)
                if o.hl then
                    o.hl.FillColor = col
                    o.hl.FillTransparency = S.espFill
                    o.hl.OutlineTransparency = S.espOutline
                end
                local pts = {}
                if S.names then table.insert(pts, plr.DisplayName) end
                if S.distEsp then table.insert(pts, "["..math.floor(d).."m]") end
                if S.hpEsp then
                    local hu = ch:FindFirstChildOfClass("Humanoid")
                    if hu then table.insert(pts, "HP "..math.floor(hu.Health)) end
                end
                o.txt.Text = table.concat(pts, "  ")
                if o.hpBg then
                    local hu = ch:FindFirstChildOfClass("Humanoid")
                    if hu and S.hpBar then
                        local pct = math.clamp(hu.Health / math.max(1, hu.MaxHealth), 0, 1)
                        o.hpBg.Visible = true
                        o.hpFg.Size = UDim2.new(1, 0, pct, 0)
                        o.hpFg.BackgroundColor3 = Color3.new(1-pct, pct, 0.2)
                    else
                        o.hpBg.Visible = false
                    end
                end
                if o.tracer then
                    local scr, on = Camera:WorldToViewportPoint(root.Position)
                    if on then
                        local vp = Camera.ViewportSize
                        local fx, fy = vp.X/2, vp.Y
                        local dx, dy = scr.X - fx, scr.Y - fy
                        local len = math.sqrt(dx*dx + dy*dy)
                        local ang = math.deg(math.atan2(dy, dx))
                        o.tracer.Size = UDim2.fromOffset(len, 1)
                        o.tracer.Position = UDim2.fromOffset(fx, fy)
                        o.tracer.Rotation = ang
                        o.tracer.BackgroundColor3 = col
                        o.tracer.Visible = true
                    else
                        o.tracer.Visible = false
                    end
                end
            end
            if S.skeleton then
                if not SkeletonMap[plr] then MakeSkelly(plr) end
                local lines = SkeletonMap[plr]
                if lines then
                    for _, ln in ipairs(lines) do
                        if ln.a and ln.a.Parent and ln.b and ln.b.Parent then
                            local from = ln.a.Position; local to = ln.b.Position
                            local dir = to - from
                            if dir.Magnitude > 0.05 then
                                ln.line.Length = dir.Magnitude
                                ln.line.CFrame = CFrame.lookAt(from + dir*0.5, to)
                                ln.line.Color3 = S.skeletonColor
                            end
                        end
                    end
                end
            else
                if SkeletonMap[plr] then KillSkelly(plr) end
            end
            if S.boxEsp then
                if not BoxMap[plr] then MakeBox(plr) end
                local frames = BoxMap[plr]
                if frames then
                    local topL = root.CFrame * Vector3.new(-1.5, 2.5, 0)
                    local botR = root.CFrame * Vector3.new(1.5, -2.5, 0)
                    local sTL, onTL = Camera:WorldToViewportPoint(topL)
                    local sBR, onBR = Camera:WorldToViewportPoint(botR)
                    if onTL and onBR then
                        local x1,y1 = sTL.X, sTL.Y
                        local x2,y2 = sBR.X, sBR.Y
                        local w,h = x2-x1, y2-y1
                        frames[1].Position = UDim2.fromOffset(x1, y1); frames[1].Size = UDim2.fromOffset(w, 1)
                        frames[2].Position = UDim2.fromOffset(x1, y1+h); frames[2].Size = UDim2.fromOffset(w, 1)
                        frames[3].Position = UDim2.fromOffset(x1, y1); frames[3].Size = UDim2.fromOffset(1, h)
                        frames[4].Position = UDim2.fromOffset(x1+w, y1); frames[4].Size = UDim2.fromOffset(1, h)
                        local col = ColorForDistance(TeamColor(plr) or S.boxColor, d)
                        for _, f in ipairs(frames) do
                            f.BackgroundColor3 = col; f.Visible = true
                        end
                    else
                        for _, f in ipairs(frames) do f.Visible = false end
                    end
                end
            else
                if BoxMap[plr] then KillBox(plr) end
            end
            if S.chams then
                if not ChamsMap[plr] then MakeChams(plr) end
            else
                if ChamsMap[plr] then KillChams(plr) end
            end
        end
    end
end

