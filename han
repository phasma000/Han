local sessionStart=os.clock()

RS.RenderStepped:Connect(function(dt)
    -- session time
    local el=math.floor(os.clock()-sessionStart)
    STime.Text="🕐 "..math.floor(el/60).."m on this server"
    SPlr.Text="👤 "..#Players:GetPlayers().." / 22"

    -- FOV circle — render behind everything, only when aim on
    FOVC.Visible = S.showFov and S.aim
    if FOVC.Visible then
        local r=S.fov*2
        FOVC.Size=UDim2.fromOffset(r,r)
        -- keep it at screen center (crosshair)
        local vp=Camera.ViewportSize
        FOVC.Position=UDim2.fromOffset(vp.X/2-r/2, vp.Y/2-r/2)
        FOVC.AnchorPoint=Vector2.new(0,0)
    end

    -- aimbot
    if S.aim and (S.held or not S.holdOnly) then
        local tgt=Target()
        if tgt then
            local desired=CFrame.lookAt(Camera.CFrame.Position,tgt.Position)
            local a=math.clamp(S.smooth*6*dt,0.01,0.5)
            Camera.CFrame=Camera.CFrame:Lerp(desired,a)
        end
    end

    if S.esp then TickESP() end
end)

